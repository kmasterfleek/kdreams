{
  "repo": "kmasterfleek/kdreams",
  "cron": "0 9 * * *",
  "slots": [
    {
      "deep": "maker-spread-capture",
      "scan": [
        "touch-size",
        "tick-size"
      ]
    },
    {
      "deep": "cross-venue-divergence",
      "scan": [
        "pair-matching",
        "resolution-rules"
      ]
    },
    {
      "deep": "liquidity-by-hour",
      "scan": [
        "weekday-effects",
        "volume-cycles"
      ]
    },
    {
      "deep": "lead-lag",
      "scan": [
        "price-discovery",
        "news-latency"
      ]
    },
    {
      "deep": "fee-modeling",
      "scan": [
        "maker-rebates",
        "category-fees"
      ]
    }
  ],
  "bonusModuli": {
    "7": "pair-catalog-review"
  },
  "controlPlaneProbes": [
    "node scripts/kdreams-backtest.mjs --summary || true",
    "npm test --silent 2>&1 | tail -5 || true"
  ],
  "buildStep": {
    "cmd": "npm ci && npm run build",
    "degradeOnWasmFailure": true
  },
  "evaluatorEntrypoints": {
    "bench": "node scripts/kdreams-backtest.mjs --json"
  },
  "adrConvention": "4-digit",
  "competitors": [
    "Kalshinomics",
    "cross-venue arbitrage bots",
    "professional market makers"
  ],
  "extraDisciplines": [
    "observe-only-no-orders",
    "evaluation-is-not-promotion",
    "witness-every-quantitative-claim",
    "fees-before-edge"
  ],
  "ledgerPath": "docs/dream-cycle/LEDGER.md",
  "branchPrefix": "dream/",
  "labels": [
    "dream-cycle",
    "research",
    "kdreams"
  ],
  "autoMerge": false
}
